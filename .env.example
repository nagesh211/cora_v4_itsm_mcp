# Copy to .env and fill in. The MCP server reads this at startup.

# --- Database (query execution) -------------------------------------------
# Per-connection DSN. The config `source.connection` is "vtx5" for all KPIs,
# so set CORA_DB_VTX5. A generic CORA_PG_DSN is used as a fallback for any
# connection name that has no specific DSN.
CORA_DB_VTX5=postgresql://user:password@host:5432/dbname

# --- LLM (autogen web/terminal clients) -----------------------------------
#OPENAI_API_KEY=sk-...
#OPENAI_BASE_URL=https://fluxlmpi/v1/
#CORA_LLM_MODEL=gpt-4.1-mini

# --- Redis (per-conversation agent state, keyed by request_uuid) ----------
REDIS_URL=redis://localhost:6379/0
CORA_STATE_TTL=86400          # seconds to keep a conversation's state

# --- KPI config store (OpenSearch) ----------------------------------------
# Required. OpenSearch is the only KPI config backend (no disk fallback).
# If OPENSEARCH_URL is unset (or opensearch-py isn't installed) the catalog
# raises at startup. Client is AsyncOpenSearch (aiohttp).
OPENSEARCH_URL=https://localhost:9200   # scheme sets SSL; host/port derived
OPENSEARCH_USERNAME=admin               # OPENSEARCH_USER also accepted
OPENSEARCH_PASSWORD=admin

OPENSEARCH_INDEX=cora-kpi-configs
OPENSEARCH_TIMEOUT=300
OPENSEARCH_MAXSIZE=30
#Alternatively set the discrete trio instead of OPENSEARCH_URL:
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USE_SSL=true

# --- MCP server -----------------------------------------------------------
CORA_MCP_HOST=0.0.0.0
CORA_MCP_PORT=8081
CORA_LOG_LEVEL=INFO

# --- URLs the clients use -------------------------------------------------
CORA_MCP_URL="http://localhost:8081/mcp"
CORA_WEB_HOST=''
CORA_WEB_PORT=''

